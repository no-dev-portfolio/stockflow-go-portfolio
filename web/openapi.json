  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "公開デモキー demo-manager-a / demo-operator-a / demo-viewer-a / demo-manager-b"
      }
    },
    "schemas": {
      "Item": {
        "type": "object",
        "required": [
          "sku",
          "quantity"
        ],
        "additionalProperties": false,
        "properties": {
          "sku": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9-]{1,31}$"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        }
      },
      "CreateReservation": {
        "type": "object",
        "required": [
          "reference",
          "ttl_seconds",
          "items"
        ],
        "additionalProperties": false,
        "properties": {
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "ttl_seconds": {
            "type": "integer",
            "minimum": 30,
            "maximum": 86400
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "$ref": "#/components/schemas/Item"
            }
          }
        }
      },
      "Reservation": {
        "type": "object",
        "required": [
          "id",
          "reference",
          "status",
          "version",
          "items",
          "expires_at",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "confirmed",
              "cancelled",
              "expired"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Item"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "request_id"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              }
            }
          }
        }
      },
      "Stock": {
        "type": "object",
        "required": [
          "sku",
          "name",
          "category",
          "on_hand",
          "reserved",
          "available",
          "threshold"
        ],
        "properties": {
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "on_hand": {
            "type": "integer",
            "minimum": 0
          },
          "reserved": {
            "type": "integer",
            "minimum": 0
          },
          "available": {
            "type": "integer",
            "minimum": 0
          },
          "threshold": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Summary": {
        "type": "object",
        "properties": {
          "products": {
            "type": "integer",
            "minimum": 0
          },
          "available": {
            "type": "integer",
            "minimum": 0
          },
          "active": {
            "type": "integer",
            "minimum": 0
          },
          "confirmed": {
            "type": "integer",
            "minimum": 0
          },
          "pending": {
            "type": "integer",
            "minimum": 0
          },
          "failed": {
            "type": "integer",
            "minimum": 0
          },
          "delivered": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Actor": {
        "type": "object",
        "properties": {
          "tenant": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      },
      "Event": {
        "type": "object",
        "properties": {
          "reservation_id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "last_error": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "delivered",
              "failed"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "next_attempt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Audit": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "reservation_id": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
