    "/api/v1/reservations/{id}/confirm": {
      "post": {
        "summary": "出荷確定",
        "description": "manager/operatorのみ。引当中のversion一致を確認。既に同じ終状態なら再送を成功として返す。期限切れの初回操作は期限切れを確定して在庫を解放し409を返す。既にexpiredの予約への再送も409 expiredを返し、在庫・履歴を追加変更しない。",
        "security": [
          {
            "apiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
