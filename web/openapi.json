      "post": {
        "summary": "在庫引当を作成",
        "description": "manager/operatorのみ。明細をSKU順に正規化。同一組織・キー・内容の再送は200、Idempotency-Replayed:true。異なる内容へのキー再利用は409。成功時は作成とOutbox・履歴を単一取引で確定。",
        "security": [
          {
            "apiKey": []
          }
        ],
        "responses": {
          "201": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reservation"
                }
              }
            }
          },
          "400": {
            "description": "入力不正",
